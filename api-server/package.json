{
  "name": "@lethe/api-server",
  "version": "1.0.0",
  "description": "API server for Lethe LLM analyzer",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "start": "bun run dist/index.js",
    "lint": "bunx eslint .",
    "test": "bun test"
  },
  "dependencies": {
    "@lethe/types": "workspace:*",
    "elysia": "^1.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
