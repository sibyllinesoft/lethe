{
  "name": "@lethe/cli",
  "version": "1.0.0", 
  "description": "NPX CLI interface for Lethe context manager",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "lethe": "./dist/cli.js"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "dev": "bun build ./src/index.ts --outdir ./dist --target bun --watch",
    "test": "bun test",
    "lint": "bunx eslint src/",
    "type-check": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@lethe/core": "workspace:*",
    "@lethe/types": "workspace:*",
    "yargs": "^17.7.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0",
    "uuid": "^9.0.0",
    "express": "^4.19.0",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/yargs": "^17.0.32",
    "@types/uuid": "^9.0.0",
    "@types/express": "^4.17.0",
    "@types/cors": "^2.8.0",
    "typescript": "^5.4.0"
  }
}
