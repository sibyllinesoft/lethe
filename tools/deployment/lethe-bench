    def _calculate_relevance(self, response: Any, expected: Any) -> float:
        """Calculate relevance score for a response (simplified)"""
        # This is a simplified relevance calculation
        # In a real implementation, this would be much more sophisticated
        
        if not response:
            return 0.0
        
        # Basic scoring based on response content
        response_str = json.dumps(response).lower()
        
        # Look for key indicators of good responses
        quality_indicators = ["result", "answer", "content", "data", "match"]
        score = 0.0
        
        for indicator in quality_indicators:
            if indicator in response_str:
                score += 0.2
        
        # Check response length (reasonable responses should have some content)
        if len(response_str) > 50:
            score += 0.3
        elif len(response_str) > 20:
            score += 0.1
        
        return min(1.0, score)
    
    def _calculate_summary_metrics(self, scenario_results: List[Dict]) -> Dict:
        """Calculate summary metrics across scenarios"""
        if not scenario_results:
            return {}
        
        # Aggregate metrics
        total_queries = sum(r["query_count"] for r in scenario_results)
        total_success = sum(r["success_count"] for r in scenario_results)
        
        all_latencies = []
        all_relevances = []
        
        for result in scenario_results:
            for query_result in result.get("results", []):
                all_latencies.append(query_result["latency_ms"])
                if query_result["success"]:
                    all_relevances.append(query_result["relevance_score"])
        
        return {
            "total_queries": total_queries,
            "total_success": total_success,
            "overall_success_rate": total_success / total_queries if total_queries else 0,
            "avg_latency_ms": np.mean(all_latencies) if all_latencies else 0,
            "p95_latency_ms": np.percentile(all_latencies, 95) if all_latencies else 0,
            "p99_latency_ms": np.percentile(all_latencies, 99) if all_latencies else 0,
            "macro_p5": np.mean(all_relevances) if all_relevances else 0,  # Simplified P@5
            "scenario_count": len(scenario_results)
        }
    
