            return False
    
    def _wait_for_services(self, systems: Dict, max_wait_minutes: int = 10) -> bool:
        """Wait for services to be healthy"""
        self.logger.info("⏳ Waiting for services to be ready...")
        
        start_time = time.time()
        timeout = max_wait_minutes * 60
        
        for system_name, config in systems.items():
            endpoint = config["endpoint"]
            self.logger.info(f"Checking {system_name} at {endpoint}...")
            
            # Extract base URL for health checks
            if "://" in endpoint:
                base_url = "/".join(endpoint.split("/")[:3])
            else:
                base_url = f"http://{endpoint.split('/')[0]}"
            
            # Wait for service
            service_ready = False
            while time.time() - start_time < timeout:
                try:
                    # Try health check endpoint first, fall back to base endpoint
                    for health_path in ["/health", "/ping", "/"]:
                        try:
                            response = requests.get(f"{base_url}{health_path}", timeout=5)
                            if response.status_code < 500:  # Accept anything but server errors
                                service_ready = True
                                break
                        except:
                            continue
                    
                    if service_ready:
                        self.logger.info(f"✅ {system_name} is ready")
                        break
                        
                except Exception:
                    pass
                
                time.sleep(10)
            
            if not service_ready:
                self.logger.warning(f"⚠️  {system_name} may not be ready after {max_wait_minutes} minutes")
        
        self.logger.info("✅ Service readiness check completed")
        return True
    
    def _execute_benchmark_matrix(self, matrix: Dict, systems_filter: Optional[List[str]] = None) -> Dict:
        """Execute the complete benchmark matrix"""
        self.logger.info("🧪 Executing benchmark matrix...")
        
        results = {
            "timestamp": datetime.now().isoformat(),
            "matrix_version": matrix.get("metadata", {}).get("version", "unknown"),
            "systems": {}
        }
        
        systems = matrix["systems"]
        if systems_filter:
            systems = {k: v for k, v in systems.items() if k in systems_filter}
        
        scenarios = matrix["scenarios"]
        
        for system_name, system_config in systems.items():
            self.logger.info(f"🔍 Testing {system_name}...")
            
            system_results = {
                "config": system_config,
                "scenarios": {},
                "summary": {}
            }
            
            # Run warmup
            self._run_warmup(system_name, system_config)
            
            # Execute each scenario
            scenario_results = []
            
            for scenario in scenarios:
                scenario_name = scenario["name"]
                self.logger.info(f"  Running scenario: {scenario_name}")
                
                scenario_result = self._run_scenario(system_name, system_config, scenario)
                system_results["scenarios"][scenario_name] = scenario_result
                scenario_results.append(scenario_result)
            
            # Calculate summary metrics
            system_results["summary"] = self._calculate_summary_metrics(scenario_results)
            results["systems"][system_name] = system_results
        
        return results
    
    def _run_warmup(self, system_name: str, system_config: Dict):
        """Run warmup queries for a system"""
        warmup_count = system_config.get("warmup_queries", 5)
        endpoint = system_config["endpoint"]
        
        warmup_query = "test warmup query"
        
        for i in range(warmup_count):
            try:
                self._execute_query(endpoint, warmup_query, timeout_ms=10000)
            except:
                pass  # Ignore warmup failures
        
        # Cool down
        time.sleep(2)
    
    def _run_scenario(self, system_name: str, system_config: Dict, scenario: Dict) -> Dict:
        """Run a single scenario against a system"""
        endpoint = system_config["endpoint"]
        timeout_ms = system_config.get("timeout_ms", 30000)
        
        # Load queries for scenario
        queries = self._load_scenario_queries(scenario)
        
        results = []
        
        for query_data in queries:
            query = query_data.get("query", "")
            expected = query_data.get("expected", None)
            
            start_time = time.time()
            
            try:
                response = self._execute_query(endpoint, query, timeout_ms=timeout_ms)
                latency_ms = (time.time() - start_time) * 1000
                
                # Calculate relevance score (simplified)
                relevance_score = self._calculate_relevance(response, expected)
                
                result = {
                    "query": query,
                    "latency_ms": latency_ms,
                    "relevance_score": relevance_score,
                    "success": True,
                    "response_length": len(str(response))
                }
                
            except Exception as e:
                latency_ms = (time.time() - start_time) * 1000
                result = {
                    "query": query,
                    "latency_ms": latency_ms,
                    "relevance_score": 0.0,
                    "success": False,
                    "error": str(e)
                }
            
            results.append(result)
        
        # Calculate scenario metrics
        latencies = [r["latency_ms"] for r in results]
        relevances = [r["relevance_score"] for r in results if r["success"]]
        success_count = sum(1 for r in results if r["success"])
        
        return {
            "query_count": len(results),
            "success_count": success_count,
            "success_rate": success_count / len(results) if results else 0,
            "avg_latency_ms": np.mean(latencies) if latencies else 0,
            "p95_latency_ms": np.percentile(latencies, 95) if latencies else 0,
            "p99_latency_ms": np.percentile(latencies, 99) if latencies else 0,
            "avg_relevance": np.mean(relevances) if relevances else 0,
            "results": results
        }
    
    def _execute_query(self, endpoint: str, query: str, timeout_ms: int = 30000) -> Any:
        """Execute a query against a system endpoint"""
        timeout_sec = timeout_ms / 1000
        
        # Simple HTTP POST for now - would need to be customized per system
        try:
            if "graphql" in endpoint.lower():
                # GraphQL query
                payload = {
                    "query": f"""{{
                        Get {{
                            Document(
                                nearText: {{ concepts: ["{query}"] }}
                                limit: 10
                            ) {{
                                content
                                _additional {{ score }}
                            }}
                        }}
                    }}"""
                }
                response = requests.post(endpoint, json=payload, timeout=timeout_sec)
            
            elif "search" in endpoint or "query" in endpoint:
                # Search endpoint
                payload = {"query": query, "limit": 10}
                response = requests.post(endpoint, json=payload, timeout=timeout_sec)
            
            else:
                # Generic endpoint
                payload = {"input": query}
                response = requests.post(endpoint, json=payload, timeout=timeout_sec)
            
            response.raise_for_status()
            return response.json()
            
        except requests.exceptions.RequestException as e:
            raise Exception(f"Query failed: {e}")
    
    def _load_scenario_queries(self, scenario: Dict) -> List[Dict]:
        """Load queries for a scenario"""
        query_file = scenario.get("query_file", "")
        
        if not query_file or not Path(query_file).exists():
            # Generate sample queries
            scenario_name = scenario["name"]
            return self._generate_sample_queries(scenario_name)
        
        queries = []
        with open(query_file) as f:
            for line in f:
                if line.strip():
                    queries.append(json.loads(line))
        
        return queries
    
