    def replay(self, matrix_file: str, systems: Optional[List[str]] = None) -> bool:
        """Replay benchmark matrix with full validation"""
        self.logger.info(f"🎯 Starting benchmark replay with {matrix_file}")
        
        try:
            # Load and validate matrix
            with open(matrix_file) as f:
                matrix = yaml.safe_load(f)
            
            if not self._validate_matrix(matrix):
                return False
            
            # Start infrastructure
            if not self._start_infrastructure():
                return False
            
            # Wait for services to be ready
            if not self._wait_for_services(matrix["systems"]):
                return False
            
            # Run benchmarks
            results = self._execute_benchmark_matrix(matrix, systems)
            
            # Run adversarial tests if enabled
            if matrix.get("adversarial", {}).get("enabled", False):
                self.logger.info("⚔️  Running adversarial test suite...")
                adv_results = self._run_adversarial_suite(matrix["adversarial"])
                results["adversarial"] = adv_results
            
            # Run throughput tests if enabled
            if matrix.get("throughput", {}).get("enabled", False):
                self.logger.info("📈 Running throughput analysis...")
                throughput_results = self._run_throughput_tests(matrix["throughput"])
                results["throughput"] = throughput_results
            
            # Validate results
            if not self._validate_results(results, matrix.get("validation", {})):
                self.logger.error("❌ Validation failed - results do not meet criteria")
                return False
            
            # Save results
            timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
            results_file = self.results_dir / f"benchmark_results_{timestamp}.json"
            with open(results_file, "w") as f:
                json.dump(results, f, indent=2, default=str)
            
            # Generate reports
            self._generate_reports(results, matrix)
            
            self.logger.info(f"✅ Benchmark replay completed successfully!")
            self.logger.info(f"📊 Results saved to {results_file}")
            
            return True
            
        except Exception as e:
            self.logger.error(f"❌ Benchmark replay failed: {e}")
            return False
    
