        qps_range = throughput_config.get("qps_range", [10, 50, 100])
        duration_sec = throughput_config.get("duration_sec", 60)
        
        for target_qps in qps_range:
            self.logger.info(f"  Testing throughput at {target_qps} QPS...")
            
            measurement = self._measure_throughput_point(target_qps, duration_sec)
            results["measurements"].append(measurement)
            
            # Stop if error rate too high
            if measurement.get("error_rate", 0) > 0.1:
                self.logger.warning(f"High error rate at {target_qps} QPS, stopping throughput test")
                break
        
        # Calculate summary
        max_qps = max((m["achieved_qps"] for m in results["measurements"]), default=0)
        results["summary"] = {
            "max_sustained_qps": max_qps,
            "measurements_count": len(results["measurements"])
        }
        
        return results
    
