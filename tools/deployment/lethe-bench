class FailClosedValidator:
    """Fail-closed validator for benchmark results"""
    
    def __init__(self, strict_mode: bool = True):
        self.strict_mode = strict_mode
        self.violations = []
    
    def validate_results(self, results_file: str) -> Tuple[bool, List[str]]:
        """Validate results file with fail-closed policy"""
        try:
            with open(results_file) as f:
                data = json.load(f)
            
            self.violations = []
            
            # Run validation checks
            self._validate_basic_structure(data)
            self._validate_system_metrics(data)
            self._validate_statistical_integrity(data)
            
            if self.violations:
                return False, self.violations
            
            return True, ["All validations passed"]
            
        except Exception as e:
            return False, [f"Validation failed with error: {e}"]
    
    def _validate_basic_structure(self, data: Dict):
        """Validate basic data structure"""
        if "systems" not in data:
            self.violations.append("Missing 'systems' section in results")
            return
        
        if not data["systems"]:
            self.violations.append("No systems found in results")
    
    def _validate_system_metrics(self, data: Dict):
        """Validate system metrics"""
        required_metrics = ["avg_latency_ms", "p95_latency_ms", "overall_success_rate", "macro_p5"]
        
        for system_name, system_data in data.get("systems", {}).items():
            summary = system_data.get("summary", {})
            
            for metric in required_metrics:
                if metric not in summary:
                    self.violations.append(f"Missing metric '{metric}' for system {system_name}")
            
            # Validate metric ranges
            success_rate = summary.get("overall_success_rate", 0)
            if success_rate < 0.5:  # 50% minimum success rate
                self.violations.append(f"Low success rate for {system_name}: {success_rate:.1%}")
            
            # Validate latency consistency
            avg_lat = summary.get("avg_latency_ms", 0)
            p95_lat = summary.get("p95_latency_ms", 0)
            if p95_lat < avg_lat:
                self.violations.append(f"P95 latency < avg latency for {system_name}")
    
    def _validate_statistical_integrity(self, data: Dict):
        """Validate statistical integrity"""
        # Check for reasonable metric ranges
        for system_name, system_data in data.get("systems", {}).items():
            summary = system_data.get("summary", {})
            
            macro_p5 = summary.get("macro_p5", 0)
            if macro_p5 > 1.0 or macro_p5 < 0:
                self.violations.append(f"Invalid macro P@5 for {system_name}: {macro_p5}")
            
            latency = summary.get("avg_latency_ms", 0)
            if latency <= 0 or latency > 300000:  # 5 minutes max
                self.violations.append(f"Unreasonable latency for {system_name}: {latency}ms")


def main():
    """Main CLI entry point"""
    parser = argparse.ArgumentParser(
        description="Lethe Benchmark CLI Tool",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
    lethe-bench replay --matrix matrix.yml
    lethe-bench replay --matrix matrix.yml --systems lethe-hybrid,weaviate
    lethe-bench validate --results runs/ --strict
    lethe-bench adversarial --suite near_duplicate_storm
    lethe-bench throughput --duration 120s --target-p95 75.0
    lethe-bench drift --old-model gemma2-9b --new-model gemma3-27b --duration 12h
    lethe-bench interactive --calculator
        """
    )
    
    subparsers = parser.add_subparsers(dest="command", help="Available commands")
    
    # Replay command
    replay_parser = subparsers.add_parser("replay", help="Replay benchmark matrix")
    replay_parser.add_argument("--matrix", required=True, help="Matrix configuration file")
    replay_parser.add_argument("--systems", help="Comma-separated list of systems to test")
    
    # Validate command
    validate_parser = subparsers.add_parser("validate", help="Validate benchmark results")
    validate_parser.add_argument("--results", required=True, help="Results directory")
    validate_parser.add_argument("--strict", action="store_true", help="Enable strict validation")
    
    # Adversarial command
    adv_parser = subparsers.add_parser("adversarial", help="Run adversarial tests")
    adv_parser.add_argument("--suite", default="all", help="Test suite to run")
    adv_parser.add_argument("--systems", help="Comma-separated list of systems to test")
    
    # Throughput command
    throughput_parser = subparsers.add_parser("throughput", help="Run throughput analysis")
    throughput_parser.add_argument("--duration", default="60s", help="Test duration")
    throughput_parser.add_argument("--target-p95", type=float, default=50.0, help="Target P95 latency")
    
    # Drift command
    drift_parser = subparsers.add_parser("drift", help="Run model drift analysis")
    drift_parser.add_argument("--old-model", required=True, help="Old model name")
    drift_parser.add_argument("--new-model", required=True, help="New model name")
    drift_parser.add_argument("--duration", default="24h", help="Analysis duration")
    
    # Interactive command
    interactive_parser = subparsers.add_parser("interactive", help="Launch interactive tools")
    interactive_parser.add_argument("--calculator", action="store_true", help="Launch decision calculator")
    
    args = parser.parse_args()
    
    if not args.command:
        parser.print_help()
        sys.exit(1)
    
    cli = LetheBenchCLI()
    
    try:
        if args.command == "replay":
            systems = args.systems.split(",") if args.systems else None
            success = cli.replay(args.matrix, systems=systems)
        
        elif args.command == "validate":
            success = cli.validate(args.results, strict=args.strict)
        
        elif args.command == "adversarial":
            systems = args.systems.split(",") if args.systems else None
            success = cli.adversarial(args.suite, systems=systems)
        
        elif args.command == "throughput":
            success = cli.throughput(args.duration, args.target_p95)
        
        elif args.command == "drift":
            success = cli.drift(args.old_model, args.new_model, args.duration)
        
        elif args.command == "interactive":
            success = cli.interactive(calculator=args.calculator)
        
        else:
            parser.print_help()
            success = False
        
        sys.exit(0 if success else 1)
        
    except KeyboardInterrupt:
        print("\n⚠️  Operation cancelled by user")
        sys.exit(130)
    except Exception as e:
        print(f"❌ Unexpected error: {e}")
        sys.exit(1)


if __name__ == "__main__":
    main()