# Dockerfile for the main benchmarking harness
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-update && apt-get install -y \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.harness.txt .
RUN pip install --no-cache-dir -r requirements.harness.txt

# Copy harness code
COPY adapter_harness.py .
COPY advantage_map_report.py .

# Create directories
RUN mkdir -p /app/results /app/datasets /app/adapters

# Copy adapter implementations
COPY adapters/ ./adapters/

# Expose port for HTTP API
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

# Start the harness server
CMD ["python", "-m", "uvicorn", "harness_api:app", "--host", "0.0.0.0", "--port", "8000"]