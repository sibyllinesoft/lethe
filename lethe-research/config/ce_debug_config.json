{
  "description": "Cross-encoder debugging configuration",
  "version": "1.0",
  
  "attestation": {
    "required_model_attributes": [
      "config", "classifier", "pooler", "encoder"
    ],
    "required_tokenizer_attributes": [
      "vocab_size", "model_max_length", "pad_token_id"
    ],
    "precision_checks": true,
    "head_validation": true,
    "special_token_validation": true,
    "abort_on_critical_issues": true
  },
  
  "synthetic_tests": {
    "min_score_std": 0.2,
    "min_score_range": 0.3,
    "identical_score_threshold": 0.7,
    "disjoint_score_threshold": 0.4,
    "require_correct_ranking": true,
    "num_test_iterations": 3,
    "floating_point_tolerance": 1e-6
  },
  
  "input_debugging": {
    "max_samples_to_log": 5,
    "expected_max_length": 512,
    "min_attention_ratio": 0.5,
    "truncation_test_length": 1000,
    "special_token_validation": true,
    "log_token_details": true,
    "check_token_type_ids": true
  },
  
  "head_validation": {
    "precision_test_iterations": 5,
    "underflow_threshold": 1e-7,
    "saturation_threshold": 1e3,
    "output_variance_threshold": 1e-8,
    "dropout_tolerance": 1e-6,
    "checkpoint_validation": true,
    "require_eval_mode": true,
    "test_precision_types": ["fp32", "fp16"]
  },
  
  "safe_mode": {
    "bi_encoder_weight": 0.6,
    "bm25_weight": 0.4,
    "facility_gamma": 0.8,
    "diversity_delta": 0.0,
    "k1_candidate_pool": 5000,
    "k2_rerank_budget": 1200,
    "dims_full": 768,
    "min_score": 0.0,
    "max_score": 1.0
  },
  
  "parameter_recommendations": {
    "immediate_adjustments": {
      "K1": {
        "recommended_range": [4000, 6000],
        "default": 5000,
        "reason": "Increase candidate pool to compensate for CE issues"
      },
      "K2": {
        "recommended_range": [1000, 1500],
        "default": 1200,
        "reason": "More reranking budget for better selection"
      },
      "dims": {
        "recommended": 768,
        "reason": "Use full dimensionality for code retrieval"
      },
      "diversity_delta": {
        "recommended": 0.0,
        "reason": "Disable DPP temporarily while fixing CE"
      },
      "facility_gamma": {
        "recommended": 0.8,
        "reason": "Emphasize facility-location for coverage"
      }
    },
    
    "coverage_targets": {
      "span_coverage": {
        "minimum": 0.1,
        "target": 0.3,
        "description": "Minimum 10% span coverage at 30% keep ratio"
      },
      "symbol_coverage": {
        "minimum": 0.1,
        "target": 0.25,
        "description": "Minimum 10% symbol coverage at 30% keep ratio"
      }
    }
  },
  
  "logging": {
    "level": "INFO",
    "detailed_tokenization": true,
    "save_attestation_log": true,
    "log_safe_mode_activations": true
  }
}