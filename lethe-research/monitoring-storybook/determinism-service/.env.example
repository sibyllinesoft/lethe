# Determinism Service Configuration

# Server Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=3001
SERVER_WORKERS=4

# Determinism Configuration
REPLAY_INTERVAL_SECONDS=3600            # Every hour (production: 1800 for 30min)
TOLERANCE_MS=1                           # ≤1ms timestamp jitter
PERFORMANCE_BUDGET_PERCENT=2.0           # p95 ≤ 2%
MAX_CONCURRENT_REPLAYS=10               # Concurrent replay limit
CLOCK_SKEW_TEST_INTERVAL_SECONDS=900    # Every 15 minutes

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/determinism
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=5
DB_CONNECT_TIMEOUT_SECONDS=30
DB_IDLE_TIMEOUT_SECONDS=600

# Monitoring Configuration
METRICS_PORT=9090
DASHBOARD_UPDATE_INTERVAL_SECONDS=60
ALERT_COOLDOWN_SECONDS=300
MAX_ALERT_HISTORY=1000

# Logging Configuration
RUST_LOG=determinism_service=info,tower_http=info

# Production Settings (uncomment for production deployment)
# REPLAY_INTERVAL_SECONDS=1800           # Every 30 minutes
# PERFORMANCE_BUDGET_PERCENT=1.5         # Stricter budget
# MAX_CONCURRENT_REPLAYS=20              # Higher concurrency
# DB_MAX_CONNECTIONS=50                  # More connections
# RUST_LOG=determinism_service=warn      # Less verbose logging