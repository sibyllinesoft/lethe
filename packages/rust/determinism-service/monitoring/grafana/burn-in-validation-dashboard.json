{
  "dashboard": {
    "id": null,
    "uid": "lethe-burn-in-validation",
    "title": "Lethe Determinism Service - 7-Day Burn-in Validation",
    "description": "Comprehensive 7-day production readiness validation tracking",
    "tags": ["lethe", "burn-in", "validation", "production"],
    "timezone": "UTC",
    "schemaVersion": 30,
    "version": 1,
    "refresh": "1m",
    "time": {
      "from": "now-7d",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    },
    "panels": [
      {
        "id": 1,
        "title": "Burn-in Progress",
        "description": "Overall 7-day burn-in validation progress",
        "type": "stat",
        "targets": [
          {
            "expr": "burn_in_progress_hours",
            "legendFormat": "Hours Completed"
          },
          {
            "expr": "(burn_in_progress_hours / 168) * 100",
            "legendFormat": "Completion %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 48
                },
                {
                  "color": "green",
                  "value": 72
                },
                {
                  "color": "blue",
                  "value": 168
                }
              ]
            },
            "unit": "h"
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Completion %"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "percent"
                },
                {
                  "id": "max",
                  "value": 100
                }
              ]
            }
          ]
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "horizontal"
        },
        "gridPos": {
          "h": 6,
          "w": 12,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "Production Gates Status (Real-time)",
        "description": "All 12 production gates status over burn-in period",
        "type": "heatmap",
        "targets": [
          {
            "expr": "gate_status",
            "format": "time_series",
            "legendFormat": "{{gate_name}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "hideFrom": {
                "legend": false,
                "tooltip": false,
                "vis": false
              },
              "scaleDistribution": {
                "type": "linear"
              }
            }
          }
        },
        "options": {
          "calculate": false,
          "calculation": {},
          "cellGap": 2,
          "cellValues": {},
          "color": {
            "exponent": 0.5,
            "fill": "dark-orange",
            "mode": "scheme",
            "reverse": false,
            "scale": "exponential",
            "scheme": "RdYlGn",
            "steps": 64
          },
          "exemplars": {
            "color": "rgba(255,0,255,0.7)"
          },
          "filterValues": {
            "le": 1e-9
          },
          "legend": {
            "show": true
          },
          "rowsFrame": {
            "layout": "auto"
          },
          "tooltip": {
            "show": true,
            "yHistogram": false
          },
          "yAxis": {
            "axisPlacement": "left",
            "reverse": false
          }
        },
        "gridPos": {
          "h": 6,
          "w": 12,
          "x": 12,
          "y": 0
        }
      },
      {
        "id": 3,
        "title": "Daily Validation Summary",
        "description": "Gate status summary by day during burn-in period",
        "type": "table",
        "targets": [
          {
            "expr": "avg_over_time(gate_status[1d])",
            "format": "table",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "center",
              "displayMode": "color-background"
            },
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            }
          }
        },
        "options": {
          "showHeader": true
        },
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true
              },
              "indexByName": {},
              "renameByName": {
                "gate_name": "Gate Name",
                "Value": "Status"
              }
            }
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 6
        }
      },
      {
        "id": 4,
        "title": "Determinism Rate Stability",
        "description": "Determinism rate consistency over 7-day period",
        "type": "timeseries",
        "targets": [
          {
            "expr": "determinism_rate",
            "legendFormat": "Determinism Rate"
          },
          {
            "expr": "0.995",
            "legendFormat": "Target (99.5%)"
          },
          {
            "expr": "avg_over_time(determinism_rate[24h])",
            "legendFormat": "24h Rolling Average"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "percentunit",
            "min": 0.99,
            "max": 1.0,
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 1,
              "fillOpacity": 10,
              "gradientMode": "none",
              "spanNulls": false,
              "insertNulls": false,
              "showPoints": "never",
              "pointSize": 5,
              "stacking": {
                "mode": "none",
                "group": "A"
              },
              "axisPlacement": "auto",
              "axisLabel": "",
              "scaleDistribution": {
                "type": "linear"
              },
              "hideFrom": {
                "legend": false,
                "tooltip": false,
                "vis": false
              },
              "thresholdsStyle": {
                "mode": "off"
              }
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Target (99.5%)"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "red"
                  }
                },
                {
                  "id": "custom.drawStyle",
                  "value": "line"
                },
                {
                  "id": "custom.lineStyle",
                  "value": {
                    "dash": [10, 10],
                    "fill": "dash"
                  }
                }
              ]
            }
          ]
        },
        "options": {
          "legend": {
            "calcs": [],
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "single"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 14
        }
      },
      {
        "id": 5,
        "title": "Performance Metrics Stability",
        "description": "Key performance metrics consistency during burn-in",
        "type": "timeseries",
        "targets": [
          {
            "expr": "p95_latency_ms",
            "legendFormat": "P95 Latency (ms)"
          },
          {
            "expr": "ece_score * 1000",
            "legendFormat": "ECE Score (×1000)"
          },
          {
            "expr": "proxy_gap * 100",
            "legendFormat": "Proxy Gap (%)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "short",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 1,
              "fillOpacity": 10,
              "gradientMode": "none",
              "spanNulls": false,
              "insertNulls": false,
              "showPoints": "never",
              "pointSize": 5,
              "stacking": {
                "mode": "none",
                "group": "A"
              },
              "axisPlacement": "auto",
              "axisLabel": "",
              "scaleDistribution": {
                "type": "linear"
              },
              "hideFrom": {
                "legend": false,
                "tooltip": false,
                "vis": false
              },
              "thresholdsStyle": {
                "mode": "off"
              }
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "P95 Latency (ms)"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "ms"
                },
                {
                  "id": "max",
                  "value": 250
                }
              ]
            }
          ]
        },
        "options": {
          "legend": {
            "calcs": ["mean", "lastNotNull", "max"],
            "displayMode": "table",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 14
        }
      },
      {
        "id": 6,
        "title": "Error Rate and Incidents",
        "description": "Error rates and incident tracking during burn-in",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(http_requests_total{status=~\"5..\"}[5m])",
            "legendFormat": "5xx Error Rate"
          },
          {
            "expr": "rate(determinism_failures_total[5m])",
            "legendFormat": "Determinism Failure Rate"
          },
          {
            "expr": "circuit_breaker_trips_total",
            "legendFormat": "Circuit Breaker Trips"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "reqps",
            "min": 0,
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 1,
              "fillOpacity": 10,
              "gradientMode": "none",
              "spanNulls": false,
              "insertNulls": false,
              "showPoints": "never",
              "pointSize": 5,
              "stacking": {
                "mode": "none",
                "group": "A"
              },
              "axisPlacement": "auto",
              "axisLabel": "",
              "scaleDistribution": {
                "type": "linear"
              },
              "hideFrom": {
                "legend": false,
                "tooltip": false,
                "vis": false
              },
              "thresholdsStyle": {
                "mode": "off"
              }
            }
          }
        },
        "options": {
          "legend": {
            "calcs": ["mean", "max", "lastNotNull"],
            "displayMode": "table",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 22
        }
      },
      {
        "id": 7,
        "title": "V2 Features Validation",
        "description": "V2 feature integration stability during burn-in",
        "type": "stat",
        "targets": [
          {
            "expr": "v2_feature_extraction_success_rate",
            "legendFormat": "V2 Feature Extraction"
          },
          {
            "expr": "certificate_system_validation_rate", 
            "legendFormat": "Certificate System"
          },
          {
            "expr": "difficulty_gate_processing_rate",
            "legendFormat": "Difficulty Gate"
          },
          {
            "expr": "learning_loop_integration_rate",
            "legendFormat": "Learning Loop"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 0.95
                },
                {
                  "color": "green",
                  "value": 0.99
                }
              ]
            },
            "unit": "percentunit",
            "min": 0.9,
            "max": 1.0
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "horizontal"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 30
        }
      },
      {
        "id": 8,
        "title": "Resource Utilization Trends",
        "description": "System resource usage stability over burn-in period",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(process_cpu_seconds_total[1m]) * 100",
            "legendFormat": "CPU Usage %"
          },
          {
            "expr": "process_resident_memory_bytes / 1024 / 1024",
            "legendFormat": "Memory Usage (MB)"
          },
          {
            "expr": "rate(http_requests_total[1m])",
            "legendFormat": "Request Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 1,
              "fillOpacity": 10,
              "gradientMode": "none",
              "spanNulls": false,
              "insertNulls": false,
              "showPoints": "never",
              "pointSize": 5,
              "stacking": {
                "mode": "none",
                "group": "A"
              },
              "axisPlacement": "auto",
              "axisLabel": "",
              "scaleDistribution": {
                "type": "linear"
              },
              "hideFrom": {
                "legend": false,
                "tooltip": false,
                "vis": false
              },
              "thresholdsStyle": {
                "mode": "off"
              }
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "CPU Usage %"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "percent"
                },
                {
                  "id": "max",
                  "value": 100
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Memory Usage (MB)"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "decbytes"
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Request Rate"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "reqps"
                }
              ]
            }
          ]
        },
        "options": {
          "legend": {
            "calcs": ["mean", "max", "lastNotNull"],
            "displayMode": "table",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 30
        }
      },
      {
        "id": 9,
        "title": "Burn-in Certification Status",
        "description": "Final certification status and gate validation summary",
        "type": "table",
        "targets": [
          {
            "expr": "burn_in_gate_certification_status",
            "format": "table",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "center",
              "displayMode": "color-background"
            },
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 0.8
                },
                {
                  "color": "green",
                  "value": 0.95
                }
              ]
            }
          }
        },
        "options": {
          "showHeader": true
        },
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true
              },
              "indexByName": {},
              "renameByName": {
                "gate_name": "Production Gate",
                "hours_green": "Hours GREEN",
                "certification_status": "Certified",
                "Value": "Final Status"
              }
            }
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 38
        }
      }
    ],
    "annotations": {
      "list": [
        {
          "name": "48-hour Milestone",
          "datasource": "prometheus",
          "enable": true,
          "expr": "burn_in_progress_hours >= 48",
          "iconColor": "yellow",
          "titleFormat": "48h Milestone Reached"
        },
        {
          "name": "72-hour Milestone", 
          "datasource": "prometheus",
          "enable": true,
          "expr": "burn_in_progress_hours >= 72",
          "iconColor": "green",
          "titleFormat": "72h Extended Validation"
        },
        {
          "name": "168-hour Completion",
          "datasource": "prometheus",
          "enable": true,
          "expr": "burn_in_progress_hours >= 168",
          "iconColor": "blue",
          "titleFormat": "7-Day Burn-in Complete"
        },
        {
          "name": "Gate Failures",
          "datasource": "prometheus",
          "enable": true,
          "expr": "changes(gate_failure_count[5m]) > 0",
          "iconColor": "red",
          "titleFormat": "Gate Failure Detected"
        }
      ]
    }
  },
  "folderId": 0,
  "overwrite": true
}