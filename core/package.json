{
  "name": "@lethe/core",
  "version": "0.2.0",
  "description": "Feature-oriented core orchestration logic for Lethe",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --minify",
    "dev": "bun --watch src/index.ts",
    "lint": "bunx tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@lethe/tokenizer": "workspace:*",
    "@lethe/types": "workspace:*"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
