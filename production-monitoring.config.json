{
  "name": "Lethe Production Monitoring Configuration",
  "version": "1.0.0",
  "description": "Production-grade monitoring for Lethe hybrid retrieval system",
  
  "monitoring": {
    "performance_metrics": {
      "hybrid_retrieval": {
        "ndcg_at_10": {
          "target": ">= 0.924",
          "alert_threshold": "< 0.900",
          "measurement_interval_ms": 5000
        },
        "response_time_p95": {
          "target": "<= 200ms", 
          "alert_threshold": "> 300ms",
          "measurement_interval_ms": 1000
        },
        "bm25_vector_fusion": {
          "alpha_beta_ratio": {
            "target": "alpha: 0.7, beta: 0.3",
            "dynamic_prediction_enabled": true
          },
          "overlap_ratio_tracking": {
            "healthy_range": "0.2 - 0.8",
            "alert_on_extreme": true
          }
        }
      },
      
      "mathematical_optimization": {
        "lambda_control_surface": {
          "primal_dual_gap": {
            "target": "<= 0.001",
            "alert_threshold": "> 0.01",
            "lambda_drift_monitoring": true
          },
          "size_function_monotonicity": {
            "validation_enabled": true,
            "violation_alert": true
          }
        },
        "determinantal_point_process": {
          "diversity_score": {
            "target": ">= 0.85",
            "measurement_unit": "percentage"
          },
          "dpp_rank_performance": {
            "delta_cbu_per_ms": {
              "track_by_rank": true,
              "optimization_target": "minimize"
            }
          }
        },
        "knapsack_optimization": {
          "token_utilization": {
            "target": ">= 0.95",
            "budget_efficiency": "CBU/token ratio"
          },
          "ilp_solver_incidence": {
            "target": "<= 0.05",
            "alert_threshold": "> 0.10"
          }
        }
      },
      
      "sentence_pruning": {
        "cross_encoder_threshold": {
          "default": 0.6,
          "dynamic_adjustment": true
        },
        "answer_span_preservation": {
          "target": ">= 0.98",
          "critical_alert_threshold": "< 0.95"
        },
        "token_reduction_ratio": {
          "target": "0.3 - 0.7",
          "efficiency_tracking": true
        }
      }
    },
    
    "system_health": {
      "embedding_services": {
        "embedding_generation_latency": {
          "target": "<= 100ms",
          "fallback_mechanism": "cached_embeddings"
        },
        "vector_search_performance": {
          "target": "<= 50ms",
          "faiss_index_health": true
        }
      },
      
      "database_performance": {
        "sqlite_query_latency": {
          "bm25_search": "<= 30ms",
          "chunk_retrieval": "<= 10ms",
          "dfidf_computation": "<= 20ms"
        },
        "connection_pool_health": {
          "max_connections": 10,
          "idle_timeout": "30s"
        }
      },
      
      "memory_management": {
        "heap_usage": {
          "warning_threshold": "80%",
          "critical_threshold": "95%"
        },
        "vector_cache_efficiency": {
          "hit_ratio_target": ">= 0.85"
        }
      }
    },
    
    "research_validation": {
      "statistical_monitoring": {
        "bootstrap_confidence_intervals": {
          "iterations": 10000,
          "confidence_level": 0.95,
          "bca_correction": true
        },
        "significance_testing": {
          "p_value_threshold": 0.001,
          "effect_size_tracking": "Cohen's d"
        }
      },
      
      "quality_assurance": {
        "mutation_testing_score": {
          "target": ">= 0.80",
          "current_achievement": 0.83
        },
        "property_testing": {
          "metamorphic_invariants": 5,
          "validation_frequency": "continuous"
        }
      },
      
      "experimental_tracking": {
        "a_b_testing": {
          "configuration_comparison": true,
          "statistical_power": ">= 0.80",
          "minimum_effect_size": 0.05
        },
        "performance_regression": {
          "baseline_comparison": "continuous",
          "alert_on_degradation": "> 5%"
        }
      }
    }
  },
  
  "alerting": {
    "channels": {
      "critical": ["email", "slack", "pagerduty"],
      "warning": ["slack", "email"],
      "info": ["slack"]
    },
    
    "escalation": {
      "mathematical_optimization_failure": {
        "severity": "critical",
        "fallback": "rust_hotpath",
        "escalation_time": "5 minutes"
      },
      "ndcg_performance_degradation": {
        "severity": "warning", 
        "threshold": "< 0.900",
        "investigation_required": true
      },
      "system_resource_exhaustion": {
        "severity": "critical",
        "automatic_scaling": true
      }
    }
  },
  
  "dashboard_configuration": {
    "primary_dashboard": {
      "name": "Lethe Production Overview",
      "panels": [
        {
          "title": "Hybrid Retrieval Performance",
          "metrics": ["ndcg_at_10", "response_time_p95", "query_throughput"],
          "visualization": "time_series"
        },
        {
          "title": "Mathematical Optimization Status", 
          "metrics": ["lambda_parameter", "dual_gap", "diversity_score"],
          "visualization": "gauge_cluster"
        },
        {
          "title": "Component Performance",
          "metrics": ["bm25_latency", "vector_search_latency", "pruning_latency"],
          "visualization": "histogram"
        },
        {
          "title": "Research Validation",
          "metrics": ["statistical_significance", "mutation_score", "test_coverage"],
          "visualization": "status_indicators"
        }
      ]
    },
    
    "mathematical_dashboard": {
      "name": "Mathematical Optimization Deep Dive",
      "panels": [
        {
          "title": "Lambda Control Surface",
          "metrics": ["lambda_evolution", "size_monotonicity", "convergence_rate"],
          "visualization": "control_surface_3d"
        },
        {
          "title": "DPP Performance Analysis",
          "metrics": ["rank_vs_performance", "orthogonal_mass", "diversity_metrics"],
          "visualization": "performance_curves"
        },
        {
          "title": "Knapsack Optimization",
          "metrics": ["token_utilization", "importance_density", "algorithm_selection"],
          "visualization": "optimization_trace"
        }
      ]
    }
  },
  
  "logging": {
    "structured_logging": {
      "format": "JSON",
      "level": "INFO",
      "include_performance_traces": true
    },
    
    "component_logging": {
      "mathematical_orchestrator": {
        "level": "DEBUG",
        "include_timing_breakdowns": true,
        "lambda_parameter_tracking": true
      },
      "hybrid_retrieval": {
        "level": "INFO", 
        "track_fusion_parameters": true,
        "ml_prediction_logging": true
      },
      "sentence_pruning": {
        "level": "INFO",
        "cross_encoder_scores": true,
        "pruning_decisions": true
      },
      "knapsack_optimizer": {
        "level": "DEBUG",
        "algorithm_selection_rationale": true,
        "optimization_trace": true
      }
    },
    
    "performance_profiling": {
      "enable_detailed_timing": true,
      "component_attribution": true,
      "memory_tracking": true,
      "critical_path_analysis": true
    }
  },
  
  "production_deployment": {
    "environment_configuration": {
      "node_env": "production",
      "log_level": "INFO",
      "performance_monitoring": true,
      "error_reporting": "sentry"
    },
    
    "scaling_configuration": {
      "auto_scaling": {
        "metric": "response_time_p95",
        "scale_up_threshold": "200ms",
        "scale_down_threshold": "100ms"
      },
      "load_balancing": {
        "strategy": "least_connections",
        "health_check": "hybrid_retrieval_ping"
      }
    },
    
    "circuit_breakers": {
      "embedding_service": {
        "failure_threshold": 5,
        "timeout": "5s",
        "fallback": "cached_embeddings"
      },
      "mathematical_optimization": {
        "failure_threshold": 3,
        "timeout": "10s", 
        "fallback": "rust_hotpath"
      }
    }
  },
  
  "research_infrastructure": {
    "continuous_validation": {
      "benchmark_frequency": "daily",
      "regression_testing": "on_deployment",
      "performance_comparison": "baseline_vs_current"
    },
    
    "experiment_management": {
      "feature_flags": {
        "mathematical_optimization": true,
        "sentence_pruning": true,
        "ml_parameter_prediction": false
      },
      "a_b_testing": {
        "traffic_split": "90/10",
        "statistical_monitoring": true
      }
    }
  }
}