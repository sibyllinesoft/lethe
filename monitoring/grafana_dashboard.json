{
  "dashboard": {
    "id": null,
    "title": "Lethe-StreamingLLM Production Monitoring",
    "tags": ["lethe", "production", "hybrid-llm"],
    "style": "dark",
    "timezone": "browser",
    "refresh": "10s",
    "time": {
      "from": "now-4h",
      "to": "now"
    },
    "templating": {
      "list": [
        {
          "name": "canary_pct",
          "type": "custom",
          "options": [
            {"text": "All", "value": "$__all"},
            {"text": "5%", "value": "5.0"},
            {"text": "25%", "value": "25.0"},
            {"text": "50%", "value": "50.0"},
            {"text": "100%", "value": "100.0"}
          ],
          "current": {"text": "5%", "value": "5.0"},
          "multi": false
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "🎯 Key Performance Indicators",
        "type": "stat",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "lethe_delta_cbu_1k",
            "legendFormat": "ΔCBU/1k"
          },
          {
            "expr": "lethe_latency_seconds{component=\"llm\",quantile=\"0.95\"} * 1000",
            "legendFormat": "LLM p95 (ms)"
          },
          {
            "expr": "lethe_kv_prefix_reuse * 100",
            "legendFormat": "KV Reuse %"
          },
          {
            "expr": "lethe_primal_dual_gap * 100",
            "legendFormat": "Dual Gap %"
          },
          {
            "expr": "lethe_canary_health * 100",
            "legendFormat": "Canary Health %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "decimals": 2,
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 70},
                {"color": "green", "value": 85}
              ]
            }
          },
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "ΔCBU/1k"},
              "properties": [
                {"id": "min", "value": 0},
                {"id": "max", "value": 12},
                {"id": "thresholds", "value": {
                  "steps": [
                    {"color": "red", "value": null},
                    {"color": "yellow", "value": 7},
                    {"color": "green", "value": 8.4}
                  ]
                }}
              ]
            },
            {
              "matcher": {"id": "byName", "options": "Dual Gap %"},
              "properties": [
                {"id": "max", "value": 1},
                {"id": "thresholds", "value": {
                  "steps": [
                    {"color": "green", "value": null},
                    {"color": "yellow", "value": 0.3},
                    {"color": "red", "value": 0.5}
                  ]
                }}
              ]
            }
          ]
        }
      },
      
      {
        "id": 2,
        "title": "📊 Per-Turn Token Economics",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "lethe_lambda",
            "legendFormat": "λ (Lambda)"
          },
          {
            "expr": "lethe_mu",
            "legendFormat": "μ (Mu)"
          },
          {
            "expr": "lethe_keep_ratio_head",
            "legendFormat": "Head Keep Ratio"
          },
          {
            "expr": "lethe_keep_ratio_tail", 
            "legendFormat": "Tail Keep Ratio"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 0.4
          }
        }
      },
      
      {
        "id": 3,
        "title": "⚡ Latency Distribution",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(lethe_latency_seconds_bucket{component=\"middleware\"}[5m])) * 1000",
            "legendFormat": "Middleware p50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(lethe_latency_seconds_bucket{component=\"middleware\"}[5m])) * 1000",
            "legendFormat": "Middleware p95"
          },
          {
            "expr": "histogram_quantile(0.50, rate(lethe_latency_seconds_bucket{component=\"llm\"}[5m])) * 1000",
            "legendFormat": "LLM p50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(lethe_latency_seconds_bucket{component=\"llm\"}[5m])) * 1000",
            "legendFormat": "LLM p95"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "min": 0
          }
        }
      },
      
      {
        "id": 4,
        "title": "🔍 Quality Metrics Trend",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "lethe_delta_cbu_1k",
            "legendFormat": "ΔCBU/1k"
          },
          {
            "expr": "lethe_precision_at_k",
            "legendFormat": "P@k"
          },
          {
            "expr": "lethe_recall_at_k",
            "legendFormat": "R@k"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "min": 0,
            "max": 1
          }
        }
      },
      
      {
        "id": 5,
        "title": "📈 Parameter Drift (24h)",
        "type": "timeseries", 
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16},
        "targets": [
          {
            "expr": "lethe_lambda_drift_24h",
            "legendFormat": "λ Drift %"
          },
          {
            "expr": "lethe_mu_drift_24h",
            "legendFormat": "μ Drift %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": -25,
            "max": 25
          }
        },
        "alert": {
          "conditions": [
            {
              "evaluator": {"params": [15], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "24h", "now"]},
              "reducer": {"type": "max"}
            }
          ],
          "name": "Parameter Drift Alert"
        }
      },
      
      {
        "id": 6,
        "title": "🔧 KV Cache Performance",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16},
        "targets": [
          {
            "expr": "lethe_kv_prefix_reuse",
            "legendFormat": "Prefix Reuse"
          },
          {
            "expr": "lethe_kv_jaccard_drop",
            "legendFormat": "Jaccard Drop"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1
          }
        }
      },
      
      {
        "id": 7,
        "title": "🎛️ Streaming Parameters",
        "type": "timeseries",
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "avg(lethe_num_windows)",
            "legendFormat": "Avg Windows"
          },
          {
            "expr": "avg(lethe_window_size)",
            "legendFormat": "Avg Window Size" 
          },
          {
            "expr": "avg(lethe_stride)",
            "legendFormat": "Avg Stride"
          },
          {
            "expr": "avg(lethe_sinks)",
            "legendFormat": "Avg Sinks"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0
          }
        }
      },
      
      {
        "id": 8,
        "title": "📊 Tail Risk Monitoring",
        "type": "timeseries",
        "gridPos": {"h": 6, "w": 12, "x": 12, "y": 24},
        "targets": [
          {
            "expr": "lethe_tail_cvar_095",
            "legendFormat": "Tail CVaR₀.₉₅"
          },
          {
            "expr": "lethe_evt_xi",
            "legendFormat": "EVT ξ Parameter"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "min": 0
          }
        }
      },
      
      {
        "id": 9,
        "title": "🚦 Canary Rollout Control",
        "type": "stat",
        "gridPos": {"h": 6, "w": 6, "x": 0, "y": 30},
        "targets": [
          {
            "expr": "lethe_canary_percentage",
            "legendFormat": "Current %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 1,
            "thresholds": {
              "steps": [
                {"color": "blue", "value": null},
                {"color": "yellow", "value": 25},
                {"color": "orange", "value": 50},
                {"color": "green", "value": 100}
              ]
            }
          }
        },
        "options": {
          "colorMode": "background"
        }
      },
      
      {
        "id": 10,
        "title": "📋 Method Comparison",
        "type": "table",
        "gridPos": {"h": 6, "w": 18, "x": 6, "y": 30},
        "targets": [
          {
            "expr": "avg by (method) (lethe_delta_cbu_1k)",
            "legendFormat": "{{method}}"
          },
          {
            "expr": "avg by (method) (lethe_latency_seconds{component=\"llm\",quantile=\"0.95\"}) * 1000",
            "legendFormat": "{{method}}"
          },
          {
            "expr": "avg by (method) (lethe_kv_prefix_reuse)",
            "legendFormat": "{{method}}"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {},
              "indexByName": {},
              "renameByName": {
                "method": "Method",
                "Value #A": "ΔCBU/1k",
                "Value #B": "p95 Latency (ms)", 
                "Value #C": "KV Reuse %"
              }
            }
          }
        ],
        "fieldConfig": {
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "ΔCBU/1k"},
              "properties": [
                {"id": "custom.displayMode", "value": "color-background"},
                {"id": "thresholds", "value": {
                  "steps": [
                    {"color": "red", "value": null},
                    {"color": "yellow", "value": 7},
                    {"color": "green", "value": 8.4}
                  ]
                }}
              ]
            }
          ]
        }
      },
      
      {
        "id": 11,
        "title": "🚨 Active Alerts",
        "type": "logs",
        "gridPos": {"h": 6, "w": 24, "x": 0, "y": 36},
        "targets": [
          {
            "expr": "ALERTS{alertname=~\".*Lethe.*|.*EVT.*|.*Drift.*|.*Canary.*\"}"
          }
        ],
        "options": {
          "showCommonLabels": false,
          "wrapLogMessage": true
        }
      },
      
      {
        "id": 12,
        "title": "📈 Request Volume by Method",
        "type": "timeseries",
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 42},
        "targets": [
          {
            "expr": "rate(lethe_requests_total{canary_pct=~\"$canary_pct\"}[5m])",
            "legendFormat": "{{method}} ({{canary_pct}}%)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "min": 0
          }
        }
      },
      
      {
        "id": 13,
        "title": "💰 Token Economics",
        "type": "timeseries",
        "gridPos": {"h": 6, "w": 12, "x": 12, "y": 42},
        "targets": [
          {
            "expr": "rate(lethe_tokens_total{type=\"head\"}[5m])",
            "legendFormat": "Head Tokens/sec"
          },
          {
            "expr": "rate(lethe_tokens_total{type=\"tail\"}[5m])",
            "legendFormat": "Tail Tokens/sec"
          },
          {
            "expr": "rate(lethe_tokens_total{type=\"total\"}[5m])",
            "legendFormat": "Total Tokens/sec"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0
          }
        }
      }
    ],
    "annotations": {
      "list": [
        {
          "name": "Deployments",
          "datasource": "prometheus",
          "expr": "changes(lethe_canary_percentage[1h]) > 0",
          "iconColor": "blue",
          "textFormat": "Canary: {{value}}%"
        },
        {
          "name": "Parameter Changes",
          "datasource": "prometheus", 
          "expr": "changes(lethe_lambda[10m]) > 0 or changes(lethe_mu[10m]) > 0",
          "iconColor": "orange",
          "textFormat": "Parameter Update"
        }
      ]
    },
    "links": [
      {
        "title": "Runbook: Parameter Drift",
        "url": "https://docs.lethe.ai/runbooks/parameter-drift",
        "icon": "doc"
      },
      {
        "title": "Canary Rollout Guide", 
        "url": "https://docs.lethe.ai/runbooks/canary-rollout",
        "icon": "cloud"
      }
    ]
  },
  "overwrite": true
}