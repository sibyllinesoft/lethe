{
  "name": "@lethe/api-server",
  "version": "0.2.0",
  "description": "Bun-powered API server that feeds the Lethe analyzer UI",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --minify",
    "dev": "bun --watch ./src/dev.ts",
    "lint": "bunx tsc --noEmit",
    "start": "bun run ./src/dev.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@lethe/types": "workspace:*"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.5.0"
  }
}
