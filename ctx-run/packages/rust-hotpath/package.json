{
  "name": "@lethe/rust-hotpath",
  "version": "0.1.0",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "lethe-hotpath",
    "triples": {
      "additional": [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "aarch64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
        "x86_64-pc-windows-msvc",
        "x86_64-apple-darwin"
      ]
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/cli": "^2.2.0"
  },
  "scripts": {
    "build": "napi build --platform --release --dts",
    "build:debug": "napi build --platform --dts",
    "version": "napi version"
  },
  "engines": {
    "node": ">= 10"
  },
  "repository": "https://github.com/napi-rs/package-template"
}