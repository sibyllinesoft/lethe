{
  "name": "@lethe/core",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "deploy:production": "tsx src/production-validation/deploy.ts",
    "deploy:lagrangian": "node scripts/deploy-lagrangian.js --config=production",
    "deploy:lagrangian:staging": "node scripts/deploy-lagrangian.js --config=staging",
    "deploy:lagrangian:dev": "node scripts/deploy-lagrangian.js --config=development",
    "deploy:lagrangian:dry-run": "node scripts/deploy-lagrangian.js --config=production --dry-run --verbose",
    "production:status": "curl -s http://localhost:3000/api/production/status | jq",
    "production:metrics": "curl -s http://localhost:3000/api/production/metrics | jq",
    "production:health": "curl -s http://localhost:3000/api/production/health | jq"
  },
  "dependencies": {
    "@lethe/sqlite": "file:../sqlite",
    "@lethe/embeddings": "file:../embeddings",
    "@types/node": "^24.3.0"
  },
  "devDependencies": {
    "typescript": "^5.5.2",
    "vitest": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "@types/fs-extra": "^11.0.4",
    "tsx": "^4.0.0"
  }
}
